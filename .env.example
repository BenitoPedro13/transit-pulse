# Local development only. Copied to .env by `make up` if .env doesn't exist.
POSTGRES_USER=transit_pulse
POSTGRES_PASSWORD=transit_pulse
POSTGRES_DB=transit_pulse

# --- adapter-its (`make adapter-its`) ---
# Redpanda's external listener from compose.yaml. Comma-separated.
KAFKA_BROKERS=127.0.0.1:29092
# Where the raw log (one gzip file per hour, every response as received) is written. Never delete
# it: it is the source of truth (CLAUDE.md invariant 2).
RAW_DIR=./var/raw
ITS_BASE_URL=https://its.mobilidade.rio
# How long after a minute ends before it is fetched. Measured, see docs/research/README.md §1.1.
ITS_MINUTE_LAG=1m
# How far back missing minutes are fetched. The API keeps at least 24 h; the extra hour is margin.
ITS_BACKFILL_WINDOW=23h
# Requests per second to the ITS gateway. The adapter refuses anything above 1 (the gateway allows 5).
ITS_RATE_PER_SEC=1
# Appended to the User-Agent as "(+<contact>)" so the provider can reach us. Leave empty in git;
# put a real address in your own .env. Do not commit an email address.
ITS_CONTACT=

# --- static routes (`make gtfs`, offline `make gtfs-export`) ---
# Uses RAW_DIR above. Optional provider contact; falls back to ITS_CONTACT.
# ZIP responses and validators stay in var/raw/gtfs/ and var/gtfs/state.json.
GTFS_CONTACT=

# --- consumer (`make consumer`) and rebuild (`make rebuild`) ---
# The compose TimescaleDB (host port 5435). Both refuse to start without it.
# The user and password are POSTGRES_USER / POSTGRES_PASSWORD above.
DATABASE_URL=postgres://transit_pulse:transit_pulse@127.0.0.1:5435/transit_pulse?sslmode=disable
# The consumer also reads KAFKA_BROKERS (above); rebuild also reads RAW_DIR (above).

# --- api (`make api`) ---
# Where the read-only API listens. Loopback: the web app reaches it through a Next.js rewrite
# (/api/* -> here), and production Caddy does the same mapping. It also reads DATABASE_URL (above).
API_ADDR=127.0.0.1:8080
# How many UTC hours of fixes the time machine keeps in memory (1-72). About 3 MB of memory and
# 1 MB of gzip per hour of Rio's buses; the database keeps 3 days.
HISTORY_HOURS=3
# Read by `next dev` (apps/web/next.config.ts), not by the API: where the /api rewrite points. Leave unset
# for `make api`; set it to reach an API on another port.
# API_ORIGIN=http://127.0.0.1:8080

# --- production (TASK-aws-infra.md) ---
# Read by the web build, not the API. Where rio.pmtiles is served from (the S3 tiles bucket output
# `tiles_base_url`). Unset = the local copy under /tiles from `make tiles`.
# NEXT_PUBLIC_TILES_BASE_URL=https://transit-pulse-tiles-860897618882.s3.us-east-1.amazonaws.com

# Capture packaged by scripts/export-replay.mjs for the backend-independent /replay route.
NEXT_PUBLIC_REPLAY_CAPTURE=2026-10-12
