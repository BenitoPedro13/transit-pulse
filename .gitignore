# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Env files (keep a committed .env.example once code exists)
.env*
!.env.example

# Research samples: commit only small, representative captures.
# Large captures (full GTFS zips, multi-poll dumps, archives) stay local;
# record their source URL and capture time in docs/research/README.md instead.
# A deliberately small, trimmed archive can still be committed with `git add -f`.
docs/research/samples/**/*.zip
docs/research/samples/**/*.gz
docs/research/samples/**/*.zst
docs/research/samples/**/*.parquet
docs/research/samples/**/*.pmtiles
docs/research/samples/**/large/
docs/research/samples/**/*.large.*
