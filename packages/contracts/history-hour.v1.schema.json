{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-pulse.local/contracts/history-hour.v1.schema.json",
  "title": "history-hour.v1",
  "description": "One UTC hour of vehicle fixes, sampled to the newest real fix per vehicle per minute (no interpolation), plus one coverage record per minute. The API serves it for the time machine; the static replay writes the same files. The fix columns are parallel arrays of equal length (JSON Schema cannot say so; the contract test checks it), ordered by (v, t).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hour_utc", "complete", "sampling", "vehicles", "fixes", "minutes"],
  "properties": {
    "schema": { "const": "history-hour.v1" },
    "hour_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$"
    },
    "complete": {
      "type": "boolean",
      "description": "True once the hour is closed and older than the backfill window (24 h): it can no longer change."
    },
    "sampling": { "const": "newest_fix_per_vehicle_per_minute" },
    "vehicles": {
      "type": "array",
      "description": "Index table. A vehicle that changes line within the hour has one entry per line.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator", "vehicle", "mode", "line"],
        "properties": {
          "operator": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "vehicle": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "line": { "type": ["string", "null"] }
        }
      }
    },
    "fixes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "lat", "lon", "spd"],
      "properties": {
        "v": { "type": "array", "description": "Index into vehicles.", "items": { "type": "integer", "minimum": 0 } },
        "t": { "type": "array", "description": "Seconds since hour_utc (event_time).", "items": { "type": "integer", "minimum": 0, "maximum": 3599 } },
        "lat": { "type": "array", "description": "Degrees times 1e5.", "items": { "type": "integer", "minimum": -9000000, "maximum": 9000000 } },
        "lon": { "type": "array", "description": "Degrees times 1e5.", "items": { "type": "integer", "minimum": -18000000, "maximum": 18000000 } },
        "spd": { "type": "array", "description": "km/h times 10; -1 means the provider sent none (missing is not zero).", "items": { "type": "integer", "minimum": -1 } }
      }
    },
    "minutes": {
      "type": "array",
      "description": "Exactly 60, one per minute of the hour. A minute whose feeds all failed, or have no row, is a gap, never zero vehicles.",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vehicles", "feeds"],
        "properties": {
          "vehicles": { "type": "integer", "minimum": 0 },
          "feeds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ok", "failed", "provider_not_ok", "gap", "missing"],
            "properties": {
              "ok": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "provider_not_ok": { "type": "integer", "minimum": 0 },
              "gap": { "type": "integer", "minimum": 0 },
              "missing": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
