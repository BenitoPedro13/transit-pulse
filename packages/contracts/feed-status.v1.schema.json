{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-pulse.local/contracts/feed-status.v1.schema.json",
  "title": "feed-status.v1",
  "description": "What happened to one (feed, minute): lets a reader tell 'no vehicles reported' from 'fetch failed'. Latest message per key wins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feed",
    "operator",
    "minute_utc",
    "status",
    "records",
    "events",
    "invalid",
    "unmapped",
    "conflicting_duplicates",
    "provider_status",
    "raw_keys"
  ],
  "properties": {
    "feed": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$" },
    "operator": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "minute_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$"
    },
    "status": { "type": "string", "enum": ["ok", "failed", "provider_not_ok", "gap"] },
    "records": { "type": "integer", "minimum": 0 },
    "events": { "type": "integer", "minimum": 0 },
    "invalid": { "type": "integer", "minimum": 0 },
    "unmapped": { "type": "integer", "minimum": 0 },
    "conflicting_duplicates": { "type": "integer", "minimum": 0 },
    "provider_status": { "type": ["string", "null"] },
    "raw_keys": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
