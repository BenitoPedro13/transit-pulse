{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-pulse.local/contracts/position.v1.schema.json",
  "title": "position.v1",
  "description": "One vehicle position fix, as emitted by a provider adapter. Nothing downstream may branch on `feed`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "city",
    "mode",
    "operator",
    "authority",
    "source_kind",
    "feed",
    "vehicle",
    "line",
    "route_id",
    "lat",
    "lon",
    "event_time",
    "received_time",
    "speed_kmh",
    "heading_deg",
    "raw_ref"
  ],
  "properties": {
    "city": { "type": "string", "enum": ["rio"] },
    "mode": { "type": "string", "enum": ["bus", "brt", "rail", "metro", "tram", "ferry"] },
    "operator": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "authority": { "type": "string", "enum": ["city", "state"] },
    "source_kind": { "type": "string", "enum": ["live", "scheduled"] },
    "feed": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$" },
    "vehicle": { "type": "string", "minLength": 1 },
    "line": { "type": ["string", "null"] },
    "route_id": { "type": ["string", "null"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "event_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "format": "date-time"
    },
    "received_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "format": "date-time"
    },
    "speed_kmh": { "type": ["number", "null"], "minimum": 0 },
    "heading_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
    "raw_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "minute_utc", "page"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "minute_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$"
        },
        "page": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
